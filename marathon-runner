#!/usr/bin/env bash

set -e

# на случай запуска не из корня проекта
cd "$(dirname "$0")"

# ── Конфиг ─────────────────────────────────────────────
# порты 5584/5586, а не дефолтные 5554/5556 — чтобы не задеть эмулятор из Android Studio
AVD_1="marathon-5584"
PORT_1=5584
AVD_2="marathon-5586"
PORT_2=5586
SYSTEM_IMAGE="system-images;android-34;google_apis;arm64-v8a"
DEVICE_PROFILE="pixel"
BOOT_WAIT=120   # пара минут, чтобы эмуляторы точно догрузились

# ── Пути к SDK-инструментам ────────────────────────────
SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$HOME/Library/Android/sdk}}"
# Marathon берёт путь к SDK из env, прокидываем явно
export ANDROID_SDK_ROOT="$SDK_ROOT"
export ANDROID_HOME="$SDK_ROOT"
AVDMANAGER="$SDK_ROOT/cmdline-tools/latest/bin/avdmanager"
EMULATOR="$SDK_ROOT/emulator/emulator"
ADB="$SDK_ROOT/platform-tools/adb"

# ── 1. Сборка apk приложения и тестов ──────────────────
echo "[1/5] Собираю apk приложения и тестов"
./gradlew :app:assembleAlphaDebug :app:assembleAlphaDebugAndroidTest

# ── 2. Создаю два AVD (--force перезаписывает старый с тем же именем) ──
echo "[2/5] Создаю два эмулятора"
echo "no" | "$AVDMANAGER" create avd --force --name "$AVD_1" --package "$SYSTEM_IMAGE" --device "$DEVICE_PROFILE"
echo "no" | "$AVDMANAGER" create avd --force --name "$AVD_2" --package "$SYSTEM_IMAGE" --device "$DEVICE_PROFILE"

# ── 3. Запускаю оба эмулятора в фоне ───────────────────
echo "[3/5] Запускаю эмуляторы на портах $PORT_1 и $PORT_2"
"$EMULATOR" -avd "$AVD_1" -no-snapshot -wipe-data -no-boot-anim -port "$PORT_1" -gpu host >"/tmp/emulator-$PORT_1.log" 2>&1 &
PID_1=$!
"$EMULATOR" -avd "$AVD_2" -no-snapshot -wipe-data -no-boot-anim -port "$PORT_2" -gpu host >"/tmp/emulator-$PORT_2.log" 2>&1 &
PID_2=$!

echo "      Жду $BOOT_WAIT сек на загрузку эмуляторов"
sleep "$BOOT_WAIT"

# ── 4. Запускаю Marathon (читает ./Marathonfile) ───────
# || true чтобы по set -e не выйти до того как погасим эмуляторы
echo "[4/5] Запускаю Marathon"
marathon || true

# ── 5. Гашу оба эмулятора ──────────────────────────────
echo "[5/5] Завершаю эмуляторы"
"$ADB" -s "emulator-$PORT_1" emu kill || true
"$ADB" -s "emulator-$PORT_2" emu kill || true
wait "$PID_1" 2>/dev/null || true
wait "$PID_2" 2>/dev/null || true

echo "Готово. Отчёт Marathon в папке marathon/ (allure-results стянуты с обоих девайсов)."